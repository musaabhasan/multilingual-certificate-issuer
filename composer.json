{
  "name": "musaabhasan/multilingual-certificate-issuer",
  "description": "Secure multilingual certificate issuance and SMTP distribution platform for Arabic and English digital credentials.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-intl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-sodium": "*",
    "mpdf/mpdf": "^8.2",
    "phpmailer/phpmailer": "^6.9",
    "ramsey/uuid": "^4.7",
    "robthree/twofactorauth": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "CertificateIssuer\\": "src/"
    }
  },
  "scripts": {
    "lint": "php bin/lint.php",
    "recipient-collision-audit": "php bin/recipient-collision-audit-demo.php",
    "recipient-data-audit": "php bin/recipient-data-audit-demo.php",
    "revocation-ledger-audit": "php bin/revocation-ledger-audit-demo.php",
    "smtp-domain-alignment-audit": "php bin/smtp-domain-alignment-audit-demo.php",
    "template-asset-audit": "php bin/template-asset-audit-demo.php",
    "worker": "php bin/queue-worker.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
