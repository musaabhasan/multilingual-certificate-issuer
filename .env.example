APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=base64:generate-32-byte-sodium-key
APP_FORCE_HTTPS=false
APP_TIMEZONE=UTC

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=certificate_issuer
DB_USERNAME=issuer
DB_PASSWORD=change-this-password

MAIL_DEFAULT_FROM=certificates@example.edu
MAIL_DEFAULT_FROM_NAME="Certificate Issuance Office"

PDF_STORAGE_PATH=storage/certificates
UPLOAD_STORAGE_PATH=storage/uploads
QUEUE_THROTTLE_SECONDS=60
QUEUE_STALE_PROCESSING_MINUTES=30
PASSWORD_ROTATION_DAYS=90
SESSION_IDLE_MINUTES=20
